{
	"info": {
		"_postman_id": "pulsewatch-api-collection-v1",
		"name": "PulseWatch API Platform",
		"description": "Production Postman Collection for PulseWatch API Monitoring Platform",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Register",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"dev@pulsewatch.io\",\n  \"password\": \"Password123!\",\n  \"full_name\": \"Lead Developer\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/register",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "register"]
						}
					}
				},
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@pulsewatch.io\",\n  \"password\": \"Password123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						}
					}
				}
			]
		},
		{
			"name": "Monitors",
			"item": [
				{
					"name": "Create Monitor",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"project_id\": \"d0000000-0000-0000-0000-000000000001\",\n  \"name\": \"Core Auth API\",\n  \"type\": \"http\",\n  \"url\": \"https://httpbin.org/status/200\",\n  \"method\": \"GET\",\n  \"interval_seconds\": 30,\n  \"expected_status_code\": 200\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/monitors",
							"host": ["{{baseUrl}}"],
							"path": ["monitors"]
						}
					}
				},
				{
					"name": "List Project Monitors",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/monitors?project_id=d0000000-0000-0000-0000-000000000001",
							"host": ["{{baseUrl}}"],
							"path": ["monitors"],
							"query": [
								{
									"key": "project_id",
									"value": "d0000000-0000-0000-0000-000000000001"
								}
							]
						}
					}
				}
			]
		},
		{
			"name": "Public Status Page",
			"item": [
				{
					"name": "Get Status Page Data",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/public/status/acme-prod-status",
							"host": ["{{baseUrl}}"],
							"path": ["public", "status", "acme-prod-status"]
						}
					}
				}
			]
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080/api/v1"
		},
		{
			"key": "accessToken",
			"value": ""
		}
	]
}
