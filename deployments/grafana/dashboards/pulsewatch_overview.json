    {
      "title": "API Request Rate (req/sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(pulsewatch_http_requests_total[1m]))",
          "legendFormat": "Total Requests"
        }
      ]
    },
    {
      "title": "Monitor Check Executions",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(pulsewatch_monitor_checks_total[1m])) by (status)",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "title": "Active Ongoing Incidents",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "pulsewatch_active_incidents_count",
          "legendFormat": "Incidents"
        }
      ]
    }
  ],
